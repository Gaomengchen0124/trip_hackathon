# Copy selected entries into server/.env.local; preserve existing settings.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
TRIP_MCP_TOKEN=
PLANNING_PORT=8790
PLANNING_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
# AUTH_DATA_FILE must match the account service.
AUTH_DATA_FILE=var/auth.sqlite
