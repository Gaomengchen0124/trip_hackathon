{
  "name": "travel-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/gen-img-manifest.mjs",
    "prebuild": "node scripts/gen-img-manifest.mjs",
    "dev": "vite",
    "build": "vite build",
    "img:manifest": "node scripts/gen-img-manifest.mjs",
    "preview": "vite preview",
    "data:gen": "node data/gen-template.mjs",
    "data:city": "node data/gen-city-stops.mjs",
    "data:check": "node data/validate.mjs --all",
    "data:rules": "node data/validate.mjs --rules",
    "engine:test": "node src/engine/demo.mjs",
    "engine:home": "node src/engine/demo-home.mjs",
    "smoke": "node scripts/smoke.mjs",
    "demo:plan": "node scripts/demo-plan.mjs",
    "e2e": "node scripts/e2e-ssr.mjs",
    "dev:api": "node scripts/start-api.mjs",
    "auth:create-admin": "node --env-file-if-exists=server/.env.auth.local scripts/create-local-admin.mjs",
    "dev:content": "sh scripts/start-content.sh",
    "dev:planning": "node scripts/start-planning.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev:all": "node scripts/start-integrated.mjs",
    "test:planning:browser": "node scripts/test-formal-planning.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "pinia": "^2.2.4",
    "undici": "^8.12.2",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "puppeteer-core": "^25.12.0",
    "vite": "^5.4.10",
    "playwright": "^1.64.1"
  }
}
