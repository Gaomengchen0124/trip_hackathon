# 默认 true；只有后端已接好时才设为 false。
VITE_USE_MOCK=true
# 留空使用 OpenStreetMap。可填 Mapbox 公共 pk. Token，重启开发服务后生效。
# 不要把 sk. 私密密钥放进前端。
VITE_MAPBOX_TOKEN=

# OpenStreetMap 地址搜索，默认 Photon 公共演示服务；生产可改为自建实例。
PHOTON_BASE_URL=https://photon.komoot.io

# DeepSeek 智能推荐：仅 Node 服务读取，填好后重启 npm run dev:api。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=20000
